# ─── Chain (Arc testnet) ───────────────────────────────────────────────
# Arc facts & gotchas: docs/reference/arc.md
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ─── Protocol keys (testnet-only hot keys; `pnpm keys` fills these) ────
DEPLOYER_KEY=
GATEWAY_ATTESTOR_KEY=
KEEPER_KEY=
AGENT_NAIVE00_KEY=
AGENT_TREASURER01_KEY=
AGENT_TREASURER02_KEY=
# Seed for deterministic fixture vendor wallets (Acme Cloud, Lumen Design, ...)
VENDOR_SEED=

# ─── Arena parameters (USDC, comma-separated T1..T4) ───────────────────
# PRD defaults are 50,250,1000,5000 / 1,2.5,10,25. Scaled down so a faucet-funded
# testnet deployment can hold real bounties at every tier.
TIER_BOUNTIES_USDC=5,10,25,50
TIER_FEES_USDC=0.25,0.5,1,2
SESSION_TTL_SECS=1800
BREACH_COOLDOWN_SECS=3600
DEMO_FAST_TIERS=true
# Seed funding per reference agent
SEED_BOUNTY_USDC=12
SEED_TREASURY_USDC=8
SEED_FLOOR_DAILY_USDC=2

# ─── LLM ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# ─── Circle (optional: agent signers via developer-controlled wallets) ─
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# ─── Services ──────────────────────────────────────────────────────────
# Postgres URL. Leave empty to use embedded Postgres (PGlite) under ./data
DATABASE_URL=
GATEWAY_PORT=8787
GATEWAY_PUBLIC_URL=http://localhost:8787
GATEWAY_JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
AGENTS_PORT=8788
AGENTS_PUBLIC_URL=http://localhost:8788
KEEPER_POLL_MS=2000
GAUNTLET_RUNS=3

# ─── Web (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
