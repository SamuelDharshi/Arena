{
  "name": "arena",
  "private": true,
  "version": "0.1.0",
  "description": "Live-fire range where anyone can try to rob an AI agent's wallet. Settled in USDC on Arc.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:local": "cross-env ARENA_ENV=local tsx scripts/dev.ts",
    "local:up": "tsx scripts/local.ts",
    "status": "tsx scripts/status.ts",
    "status:local": "cross-env ARENA_ENV=local tsx scripts/status.ts",
    "keys": "tsx scripts/gen-keys.ts",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "abi": "tsx scripts/export-abi.ts",
    "deploy:arc": "tsx scripts/deploy.ts",
    "seed:arc": "tsx scripts/seed.ts",
    "attack": "tsx scripts/attack.ts",
    "attack:local": "cross-env ARENA_ENV=local NEXT_PUBLIC_GATEWAY_URL=http://localhost:9787 tsx scripts/attack.ts",
    "smoke:agents": "pnpm --filter @arena/agents smoke",
    "dev:agents": "pnpm --filter @arena/agents dev",
    "dev:gateway": "pnpm --filter @arena/gateway dev",
    "dev:keeper": "pnpm --filter @arena/keeper dev",
    "dev:web": "pnpm --filter @arena/web dev",
    "build:web": "pnpm --filter @arena/web build",
    "typecheck": "pnpm -r typecheck",
    "go-live": "tsx scripts/go-live.ts",
    "start:gateway": "pnpm --filter @arena/gateway start",
    "start:agents": "pnpm --filter @arena/agents start",
    "circle:setup": "tsx scripts/circle-setup.ts",
    "verify:arc": "tsx scripts/verify-arc.ts",
    "arc:repro": "tsx scripts/arc-underpriced-repro.ts",
    "arc:doctor": "tsx scripts/arc-doctor.ts",
    "x402:demo": "tsx scripts/x402-demo.ts",
    "memory:backfill": "tsx scripts/memory-backfill.ts",
    "selftest": "pnpm --filter @arena/memory selftest && pnpm --filter @arena/agents selftest"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@circle-fin/x402-batching": "^3.5.0",
    "@openzeppelin/merkle-tree": "^1.0.7",
    "@types/node": "^22.9.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "viem": "^2.21.45"
  }
}
